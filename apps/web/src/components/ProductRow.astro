---
import type { ProductListItem } from '../lib/api';

interface Props {
  product: ProductListItem;
  index?: number;
  badge?: string;
  institution?: string;
  techStack?: string[];
  voterAvatars?: string[];
}
const { product, index, badge, institution, techStack = [], voterAvatars = [] } = Astro.props;
const initials = product.name.split(' ').slice(0, 2).map((w) => w[0]).join('').toUpperCase();

const palette = ['#7c5cff', '#22c55e', '#ec4899', '#facc15', '#06b6d4', '#f97316'];
const logoBg = palette[product.name.charCodeAt(0) % palette.length];
---
<article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-card transition-shadow hover:shadow-card-hover">
  <div class="flex items-start gap-4">
    <div class="flex flex-col items-center gap-1 w-12 shrink-0">
      <button
        class="flex h-11 w-11 items-center justify-center rounded-lg border border-slate-200 bg-slate-50 text-slate-400 transition-colors hover:border-purple-400 hover:text-purple-500"
        aria-label="Votar"
        data-vote-btn
        data-product-id={product.id}
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m18 15-6-6-6 6"/></svg>
      </button>
      <span class="text-sm font-bold text-slate-700" data-vote-count>{product._count.votes}</span>
    </div>

    <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl text-white font-bold" style={`background-color: ${logoBg}`}>
      {product.logoUrl ? <img src={product.logoUrl} alt={product.name} class="h-full w-full rounded-xl object-cover" /> : initials}
    </div>

    <div class="min-w-0 flex-1">
      <div class="flex flex-wrap items-center gap-2">
        {typeof index === 'number' && <span class="text-xs font-mono text-slate-400">#{index + 1}</span>}
        <a href={`/products/${product.id}`} class="text-base font-bold text-slate-900 hover:text-purple-600">{product.name}</a>
        {badge && <span class="rounded-md bg-amber-100 px-1.5 py-0.5 text-[11px] font-bold text-amber-700">🏆 {badge}</span>}
        {product.category && (
          <span class="chip-purple" style={`background-color: ${product.category.color}1a; color: ${product.category.color}`}>
            {product.category.name}
          </span>
        )}
      </div>
      <p class="mt-1 text-sm text-slate-600">{product.tagline}</p>
      {techStack.length > 0 && (
        <div class="mt-2 flex flex-wrap gap-1.5">
          {techStack.slice(0, 4).map((t) => <span class="chip">{t}</span>)}
        </div>
      )}

      <div class="mt-3 flex flex-wrap items-center justify-between gap-3 text-sm text-slate-500">
        <div class="flex items-center gap-2">
          <span class="flex h-7 w-7 items-center justify-center rounded-full bg-slate-200 text-[11px] font-bold text-slate-700">
            {product.hunter.username.slice(0, 2).toUpperCase()}
          </span>
          <div class="leading-tight">
            <p class="font-medium text-slate-700">{product.hunter.username}</p>
            {institution && <p class="text-xs text-slate-500">{institution}</p>}
          </div>
        </div>
        <div class="flex items-center gap-3">
          {voterAvatars.length > 0 && (
            <div class="flex -space-x-1">
              {voterAvatars.slice(0, 4).map((_, i) => (
                <span class="flex h-6 w-6 items-center justify-center rounded-full border-2 border-white bg-slate-200 text-[10px] font-bold text-slate-700">
                  {String.fromCharCode(65 + ((i + product.name.length) % 26))}
                </span>
              ))}
              <span class="ml-2 text-xs text-slate-500">+{voterAvatars.length}</span>
            </div>
          )}
          <span class="flex items-center gap-1 text-slate-500">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            {product._count.comments}
          </span>
        </div>
      </div>
    </div>
  </div>
</article>
