---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { api, type ProductDetail } from '../../lib/api';
import { getToken } from '../../lib/auth';

const token = getToken(Astro);
let user = null;
if (token) { try { user = (await api.me(token)); } catch {} }

const { id } = Astro.params;
if (!id) return Astro.redirect('/');

let product: ProductDetail | null = null;
try { product = await api.getProduct(id); } catch {}

const initials = product ? product.name.split(' ').slice(0, 2).map((w) => w[0]).join('').toUpperCase() : '';
const commentError = Astro.url.searchParams.get('comment_error');
---
<BaseLayout title={product ? `${product.name} · hunterrd` : 'Proyecto · hunterrd'} user={user}>
  {!product ? (
    <div class="mx-auto max-w-md py-20 text-center">
      <h1 class="text-2xl font-extrabold text-slate-900">Proyecto no encontrado</h1>
      <a href="/" class="btn-primary mt-6">Volver al inicio</a>
    </div>
  ) : (
    <article class="mx-auto max-w-5xl px-4 py-10">
      <header class="rounded-2xl border border-slate-200 bg-white p-6 shadow-card md:p-8">
        <div class="flex flex-wrap items-start gap-5">
          <div class="flex flex-col items-center gap-1 w-14 shrink-0">
            <button class="flex h-14 w-14 items-center justify-center rounded-xl border border-slate-200 bg-slate-50 text-slate-500 transition-colors hover:border-purple-400 hover:text-purple-500" data-vote-btn data-product-id={product.id} aria-label="Votar">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m18 15-6-6-6 6"/></svg>
            </button>
            <span class="text-base font-bold text-slate-700" data-vote-count>{product._count.votes}</span>
          </div>

          <div class="flex h-20 w-20 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-purple-500 to-purple-700 text-2xl font-extrabold text-white">
            {product.logoUrl ? <img src={product.logoUrl} class="h-full w-full rounded-2xl object-cover" /> : initials}
          </div>

          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-2">
              <h1 class="text-2xl font-extrabold text-slate-900 md:text-3xl">{product.name}</h1>
              {product.category && (
                <span class="chip-purple" style={`background-color: ${product.category.color}1a; color: ${product.category.color}`}>{product.category.name}</span>
              )}
            </div>
            <p class="mt-2 text-base text-slate-700">{product.tagline}</p>
            <div class="mt-3 flex flex-wrap items-center gap-3 text-sm text-slate-500">
              <span class="flex items-center gap-2">
                <span class="flex h-7 w-7 items-center justify-center rounded-full bg-purple-100 text-[11px] font-bold text-purple-700">{product.hunter.username.slice(0, 2).toUpperCase()}</span>
                <a href={`/u/${product.hunter.username}`} class="hover:text-purple-600">@{product.hunter.username}</a>
              </span>
              <span>·</span>
              <span>{new Date(product.createdAt).toLocaleDateString('es')}</span>
              {product.url && (<><span>·</span><a href={product.url} target="_blank" rel="noopener noreferrer" class="font-medium text-purple-600 hover:underline">Visitar sitio ↗</a></>)}
            </div>
          </div>
        </div>
      </header>

      {product.description && (
        <section class="mt-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-card">
          <h2 class="text-lg font-bold text-slate-900">Acerca de</h2>
          <p class="mt-2 whitespace-pre-wrap text-slate-700">{product.description}</p>
        </section>
      )}

      <section class="mt-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-card">
        <h2 class="mb-4 text-lg font-bold text-slate-900">Comentarios ({product.comments.length})</h2>

        {commentError && <div class="mb-4 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">{commentError}</div>}

        {user ? (
          <form method="POST" action={`/api/products/${product.id}/comments`} class="mb-6 space-y-2">
            <textarea class="input" name="body" required minlength="1" maxlength="2000" rows="3" placeholder="¿Qué opinas de este proyecto?"></textarea>
            <div class="flex justify-end">
              <button type="submit" class="btn-primary">Comentar</button>
            </div>
          </form>
        ) : (
          <div class="mb-6 rounded-lg bg-slate-50 p-4 text-sm text-slate-600">
            <a href={`/login?next=/products/${product.id}`} class="font-semibold text-purple-600 hover:underline">Inicia sesión</a> para comentar.
          </div>
        )}

        <ul class="space-y-5">
          {product.comments.length === 0 ? (
            <li class="text-sm text-slate-500">Sé el primero en comentar.</li>
          ) : (
            product.comments.map((c) => (
              <li class="flex gap-3">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-purple-100 text-xs font-bold text-purple-700">{c.user.username.slice(0, 2).toUpperCase()}</span>
                <div class="min-w-0 flex-1">
                  <div class="flex items-baseline gap-2 text-sm">
                    <a href={`/u/${c.user.username}`} class="font-semibold text-slate-900 hover:text-purple-600">@{c.user.username}</a>
                    <span class="text-xs text-slate-400">{new Date(c.createdAt).toLocaleString('es')}</span>
                  </div>
                  <p class="mt-1 whitespace-pre-wrap text-sm text-slate-700">{c.body}</p>
                </div>
              </li>
            ))
          )}
        </ul>
      </section>
    </article>
  )}
</BaseLayout>
