---
import BaseLayout from '../layouts/BaseLayout.astro';
import { api } from '../lib/api';
import { getToken } from '../lib/auth';

const token = getToken(Astro);
let user = null;
if (token) { try { user = (await api.me(token)); } catch {} }

let categories: any[] = [];
try { categories = await api.listCategories(); } catch {}

const icons: Record<string, string> = {
  'ia-machine-learning': '🤖',
  'edtech': '🎓',
  'salud-bienestar': '💚',
  'fintech': '💳',
  'medio-ambiente': '🌱',
  'productividad': '⚡',
  'social-impacto': '🤝',
  'videojuegos': '🎮',
  'herramientas-dev': '🛠',
};
---
<BaseLayout title="Categorías · hunterrd" user={user}>
  <section class="mx-auto max-w-7xl px-4 py-12">
    <h1 class="text-3xl font-extrabold text-slate-900">Categorías</h1>
    <p class="mt-2 text-sm text-slate-500">Explora proyectos por temática.</p>

    {categories.length === 0 ? (
      <div class="mt-8 rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center text-sm text-slate-500">Aún no hay categorías.</div>
    ) : (
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {categories.map((c) => (
          <a href={`/?category=${c.slug}`} class="flex items-center gap-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-card transition-shadow hover:shadow-card-hover">
            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-purple-50 text-2xl">{icons[c.slug] ?? '🏷'}</div>
            <div class="flex-1">
              <p class="font-bold text-slate-900">{c.name}</p>
              <p class="text-xs text-slate-500">{c._count?.products ?? 0} proyectos</p>
            </div>
            <span class="text-slate-400">→</span>
          </a>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
