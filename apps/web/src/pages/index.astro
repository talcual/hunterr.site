---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductRow from '../components/ProductRow.astro';
import ProductHeroCard from '../components/ProductHeroCard.astro';
import FeaturedProjectCard from '../components/FeaturedProjectCard.astro';
import StepCard from '../components/StepCard.astro';
import { api, type Category } from '../lib/api';
import { getToken } from '../lib/auth';

const token = getToken(Astro);
let user: { id: string; username: string } | null = null;
if (token) { try { user = (await api.me(token)); } catch {} }

let productsData = { items: [], total: 0 };
let categories: Category[] = [];
try {
  [productsData, categories] = await Promise.all([
    api.listProducts({ sort: 'new', limit: 12 }),
    api.listCategories(),
  ]);
} catch (e) {
  console.error('Error cargando datos:', e);
}

const items = productsData.items;
const top3 = items.slice(0, 3);
const topDay = items.slice(0, 5);
const featured = items.slice(0, 3);

const categoryIcons: Record<string, string> = {
  'ia-machine-learning': '🤖',
  'edtech': '🎓',
  'salud-bienestar': '💚',
  'fintech': '💳',
  'medio-ambiente': '🌱',
  'productividad': '⚡',
  'social-impacto': '🤝',
  'videojuegos': '🎮',
  'herramientas-dev': '🛠',
};

const steps = [
  { icon: 'upload' as const, title: 'Publica tu proyecto', description: 'Comparte tu idea, demo, capturas y tecnologías usadas.' },
  { icon: 'vote' as const, title: 'Recibe votos y feedback', description: 'La comunidad descubre, prueba y apoya tus proyectos.' },
  { icon: 'trophy' as const, title: 'Gana visibilidad', description: 'Haz que tu talento llegue a empresas, inversionistas y al mundo.' },
];
---
<BaseLayout title="hunterrd — Descubre proyectos estudiantiles" user={user}>
  <section class="relative overflow-hidden bg-ink-900 text-white">
    <div class="absolute inset-0 opacity-30" style="background: radial-gradient(80% 50% at 20% 0%, rgba(124,92,255,0.5), transparent), radial-gradient(60% 50% at 100% 30%, rgba(236,72,153,0.25), transparent);"></div>
    <div class="relative mx-auto grid max-w-7xl items-center gap-10 px-4 py-16 md:grid-cols-2 md:py-24">
      <div>
        <span class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/5 px-3 py-1 text-xs font-medium text-purple-200">
          🚀 La vitrina de talento estudiantil
        </span>
        <h1 class="mt-5 text-4xl font-extrabold leading-tight tracking-tight md:text-6xl">
          Grandes ideas<br />empiezan en el <span class="text-purple-300">aula</span>.
        </h1>
        <p class="mt-4 max-w-md text-base text-slate-300 md:text-lg">
          Descubre, vota y comparte los mejores proyectos creados por estudiantes de todo el mundo.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="#top" class="btn-primary">Explorar proyectos <span class="opacity-70">→</span></a>
          <a href="/submit" class="btn-outline border-white/30 bg-white/5 text-white hover:bg-white/10">Publicar mi proyecto</a>
        </div>
        <div class="mt-10 grid grid-cols-3 gap-6 border-t border-white/10 pt-6 text-sm">
          <div>
            <p class="text-2xl font-extrabold text-white">1.2K</p>
            <p class="text-slate-400">Proyectos publicados</p>
          </div>
          <div>
            <p class="text-2xl font-extrabold text-white">28K</p>
            <p class="text-slate-400">Votos de la comunidad</p>
          </div>
          <div>
            <p class="text-2xl font-extrabold text-white">150+</p>
            <p class="text-slate-400">Instituciones</p>
          </div>
        </div>
      </div>

      <div class="relative h-80 md:h-96">
        {top3.length === 0 ? (
          <div class="flex h-full items-center justify-center rounded-2xl border border-white/10 bg-white/5 text-slate-300">
            <p>Aún no hay proyectos destacados.</p>
          </div>
        ) : (
          <div class="relative h-full">
            {top3[0] && <div class="absolute left-0 top-0"><ProductHeroCard product={top3[0]} rank={1} rot="rotate-[-3deg]" /></div>}
            {top3[1] && <div class="absolute right-2 top-12"><ProductHeroCard product={top3[1]} rank={2} rot="rotate-[4deg]" /></div>}
            {top3[2] && <div class="absolute bottom-2 left-1/3"><ProductHeroCard product={top3[2]} rank={3} rot="rotate-[-1deg]" /></div>}
          </div>
        )}
      </div>
    </div>
  </section>

  <section id="top" class="mx-auto max-w-7xl px-4 py-14">
    <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
      <div>
        <h2 class="flex items-center gap-2 text-2xl font-extrabold text-slate-900 md:text-3xl">
          <span class="text-2xl">🔥</span> Top del día
        </h2>
        <p class="mt-1 text-sm text-slate-500">Los proyectos más votados por la comunidad</p>
      </div>
      <div class="flex gap-2 text-sm">
        <a href="#top" class="rounded-full bg-ink-900 px-3 py-1 font-semibold text-white">Hoy</a>
        <a href="#top" class="rounded-full px-3 py-1 font-medium text-slate-600 hover:bg-slate-100">Esta semana</a>
        <a href="#top" class="rounded-full px-3 py-1 font-medium text-slate-600 hover:bg-slate-100">Este mes</a>
        <a href="#top" class="rounded-full px-3 py-1 font-medium text-slate-600 hover:bg-slate-100">Todos</a>
      </div>
    </div>

    <div class="grid gap-6 lg:grid-cols-[1fr_280px]">
      <div class="space-y-3">
        {topDay.length === 0 ? (
          <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center">
            <p class="text-slate-500">Aún no hay proyectos hoy.</p>
            <a href="/submit" class="btn-primary mt-3">Sé el primero en publicar</a>
          </div>
        ) : (
          topDay.map((p, i) => <ProductRow product={p} index={i} badge={i === 0 ? '1°' : undefined} />)
        )}
        <div class="pt-2 text-center">
          <a href="#top" class="btn-outline">Ver más proyectos ↓</a>
        </div>
      </div>

      <aside class="space-y-6">
        <div>
          <h3 class="mb-3 text-base font-bold text-slate-900">Categorías</h3>
          <ul class="space-y-1">
            <li>
              <a href="/" class="flex items-center justify-between rounded-lg px-3 py-2 text-sm font-semibold bg-purple-50 text-purple-700">
                <span class="flex items-center gap-2">🏷 Todas las categorías</span>
              </a>
            </li>
            {categories.map((c) => (
              <li>
                <a href={`/?category=${c.slug}`} class="flex items-center justify-between rounded-lg px-3 py-2 text-sm text-slate-700 hover:bg-slate-100">
                  <span class="flex items-center gap-2">
                    <span>{categoryIcons[c.slug] ?? '🏷'}</span> {c.name}
                  </span>
                  <span class="text-xs text-slate-400">{c._count?.products ?? 0}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        {topDay.length > 0 && (
          <div class="rounded-2xl border border-slate-200 bg-white p-5">
            <h3 class="mb-3 text-base font-bold text-slate-900">Top de la semana</h3>
            <ol class="space-y-3">
              {topDay.slice(0, 5).map((p, i) => (
                <li class="flex items-center gap-3">
                  <span class="flex h-6 w-6 items-center justify-center rounded-full bg-slate-100 text-xs font-bold text-slate-600">{i + 1}</span>
                  <div class="flex h-7 w-7 items-center justify-center rounded-md bg-gradient-to-br from-purple-500 to-purple-700 text-[10px] font-bold text-white">
                    {p.name.slice(0, 2).toUpperCase()}
                  </div>
                  <div class="min-w-0 flex-1">
                    <a href={`/products/${p.id}`} class="block truncate text-sm font-semibold text-slate-900 hover:text-purple-600">{p.name}</a>
                    <p class="text-xs text-slate-500">{(p._count.votes / 1000).toFixed(1)}K votos</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        )}

        <div class="rounded-2xl bg-gradient-to-br from-purple-500 to-purple-700 p-6 text-white">
          <div class="flex h-10 w-10 items-center justify-center rounded-full bg-white/20">
            🚀
          </div>
          <h3 class="mt-3 text-lg font-extrabold">¿Listo para mostrar tu proyecto?</h3>
          <p class="mt-1 text-sm text-purple-100">Publica tu proyecto, recibe feedback, consigue visibilidad y conecta con oportunidades.</p>
          <a href="/submit" class="mt-4 inline-block rounded-lg bg-white px-4 py-2 text-sm font-bold text-purple-700 hover:bg-purple-50">Publicar proyecto →</a>
        </div>
      </aside>
    </div>
  </section>

  <section id="rankings" class="bg-slate-50 py-14">
    <div class="mx-auto max-w-7xl px-4">
      <div class="mb-6">
        <h2 class="flex items-center gap-2 text-2xl font-extrabold text-slate-900 md:text-3xl">
          <span class="text-2xl">⭐</span> Proyectos destacados
        </h2>
        <p class="mt-1 text-sm text-slate-500">Selección editorial de proyectos innovadores</p>
      </div>
      {featured.length === 0 ? (
        <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center text-slate-500">
          Aún no hay proyectos destacados.
        </div>
      ) : (
        <div class="grid gap-5 md:grid-cols-3">
          {featured.map((p, i) => (
            <FeaturedProjectCard
              product={p}
              badge={i === 0 ? '⭐ TOP 1' : i === 1 ? '⭐ TOP 2' : '⭐ TOP 3'}
              categoryLabel={p.category?.name}
              description={p.tagline}
            />
          ))}
        </div>
      )}
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-14">
    <div class="mb-8">
      <h2 class="flex items-center gap-2 text-2xl font-extrabold text-slate-900 md:text-3xl">
        <span class="text-2xl">⚡</span> Cómo funciona
      </h2>
      <p class="mt-1 text-sm text-slate-500">Del aula al mundo en 3 simples pasos</p>
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      {steps.map((s, i) => <StepCard number={i + 1} {...s} />)}
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-16">
    <div class="relative overflow-hidden rounded-3xl bg-purple-50 p-8 md:p-12">
      <span class="absolute left-6 top-6 text-6xl font-serif text-purple-300/70">"</span>
      <div class="relative grid items-center gap-8 md:grid-cols-[1fr_auto]">
        <div>
          <p class="text-lg font-medium text-slate-800 md:text-xl">
            "hunterrd me ayudó a que mi proyecto de clase se hiciera viral. Hoy trabajo en una startup gracias a la visibilidad que obtuve."
          </p>
          <div class="mt-5 flex items-center gap-3">
            <div class="flex h-12 w-12 items-center justify-center rounded-full bg-gradient-to-br from-purple-400 to-purple-600 text-sm font-bold text-white">CR</div>
            <div>
              <p class="font-semibold text-slate-900">Camila Rodríguez</p>
              <p class="text-sm text-slate-500">Ex estudiante, ahora Product Designer</p>
            </div>
          </div>
        </div>
        <div class="hidden md:block">
          <div class="rounded-2xl bg-white p-3 shadow-card">
            <div class="grid h-32 w-56 grid-cols-6 grid-rows-4 gap-1">
              {Array.from({ length: 24 }).map((_, i) => (
                <div class={`rounded-sm ${['bg-purple-200', 'bg-purple-300', 'bg-purple-400', 'bg-purple-500'][i % 4]}`} style={`opacity: ${0.3 + ((i * 13) % 70) / 100}`}></div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  document.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest('[data-vote-btn]') as HTMLButtonElement | null;
    if (!btn) return;
    e.preventDefault();
    const id = btn.dataset.productId;
    const token = document.cookie.match(/(?:^|;\s*)hunterrd_token=([^;]+)/)?.[1];
    if (!token) { window.location.href = '/login?next=' + encodeURIComponent(window.location.pathname); return; }
    btn.disabled = true;
    try {
      const res = await fetch(`/api/v1/votes/${id}/toggle`, { method: 'POST', headers: { Authorization: `Bearer ${token}` } });
      if (!res.ok) throw new Error();
      const data = await res.json();
      const countEl = btn.parentElement?.querySelector('[data-vote-count]');
      if (countEl) {
        const current = parseInt(countEl.textContent || '0', 10);
        countEl.textContent = String(current + (data.voted ? 1 : -1));
      }
      btn.classList.toggle('text-purple-500', data.voted);
      btn.classList.toggle('border-purple-400', data.voted);
    } catch { alert('No se pudo registrar el voto'); } finally { btn.disabled = false; }
  });
</script>
